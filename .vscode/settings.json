{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/.trunk/*actions/": true,
        "**/.trunk/*logs/": true,
        "**/.trunk/*notifications/": true,
        "**/.trunk/*out/": true,
        "**/.trunk/*plugins/": true
    },
    "explorerExclude.backup": {},
    "autoRestart.excludePatterns": [
        "**/node_modules/**",
        "**/.dist/**",
        "**/node_modules", // 第三方依赖，不需要编译
        "**/dist", // 编译输出目录
        "**/build", // 构建输出目录
        "coverage", // 测试覆盖率报告
        ".vscode", // VS Code 配置文件夹
        ".idea", // JetBrains IDE 配置文件夹
        "**/*.spec.ts", // 单元测试文件（如果不需要编译）
        "**/__tests__", // 测试文件夹
        "**/.git"
    ],
    "typescript.tsserver.maxTsServerMemory": 2048, // 限制内存为 4GB
    "typescript.tsserver.watchOptions": {
        "watchFile": "useFsEvents", // 使用系统文件监听（Mac/Windows）
        "watchDirectory": "useFsEvents"
    },
    "typescript.tsserver.experimental.enableProjectDiagnostics": false, // 禁用全项目诊断
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/.git/**": true
    }
}