{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "**/*.d.ts",
    "src/renderer/**/*.vue",
    "src/renderer/**/*.ts",
    "src/preload/*.ts",
  ],
  "compilerOptions": {
    "moduleResolution": "bundler",
    "types": [
      "vite/client"
    ],
    "composite": true,
    "baseUrl": "./",
    "paths": {
      "@renderer/*": [
        "./src/renderer/*"
      ]
    },
  },
}